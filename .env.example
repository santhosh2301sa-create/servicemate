# GEMINI_API_KEY: Optional for AI Studio runtime environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port for the Express + Vite server (default: 3000)
PORT=3000

# SESSION_SECRET: Secret key used to sign authentication tokens.
# Leave unset in local dev to generate an ephemeral secret in memory,
# or set a strong random string in production.
SESSION_SECRET=

# ADMIN_PASSCODE: Optional server-side admin passcode.
# If left empty, the first user to open the Admin Setup form can claim the initial admin account.
ADMIN_PASSCODE=

# DATABASE_PATH: Path to the SQLite database file (default: ./data/servicemate.db)
DATABASE_PATH=./data/servicemate.db
